# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI="YOUR_MONGO_URI"
# For Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/hostel-snacks

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Admin Seed Credentials (used by seed script)
ADMIN_EMAIL=admin@hostel.com
ADMIN_PASSWORD=Admin@123

# UPI Details (shown to customers on checkout)
UPI_ID=yourupi@upi
UPI_NAME=Hostel Snacks Store
UPI_QR_URL=YOUR_QR_CODE_URL

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Email Settings
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=onboarding@resend.dev
FROM_NAME="HostelBite"
