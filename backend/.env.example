# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI="YOUR_MONGO_URI"
# For Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/hostel-snacks

# JWT
# Must be at least 32 characters (the server refuses to start otherwise).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRE=7d

# Admin Seed Credentials (used by seed script and scripts/create-admin.js)
# Required — there is no hardcoded fallback.
ADMIN_EMAIL=admin@hostel.com
ADMIN_PASSWORD=Admin@123

# UPI Details (shown to customers on checkout)
UPI_ID=yourupi@upi
UPI_NAME=Hostel Snacks Store
UPI_QR_URL=YOUR_QR_CODE_URL

# Frontend URL (for CORS). Comma-separated for multiple allowed origins.
FRONTEND_URL=http://localhost:5173

# Email Settings (Brevo free SMTP relay — 300 emails/day, no cost)
# 1. Sign up free at https://www.brevo.com
# 2. Go to Settings > SMTP & API > SMTP tab to get your SMTP login + key
# BREVO_SMTP_USER is your Brevo account login email (not your Brevo password)
# BREVO_SMTP_KEY is the generated SMTP key shown there (not your account password)
BREVO_SMTP_USER=your_brevo_login_email@example.com
BREVO_SMTP_KEY=your_brevo_smtp_key
FROM_EMAIL=onboarding@yourdomain.com
FROM_NAME="HostelBite"

# ─── Rate limiting (all optional — sensible defaults are used if unset) ───
# General API limiter (applies to all /api routes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Login limiter (brute-force protection)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# Registration limiter
REGISTER_RATE_LIMIT_WINDOW_MS=900000
REGISTER_RATE_LIMIT_MAX=10

# Forgot-password limiter
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
FORGOT_PASSWORD_RATE_LIMIT_MAX=5

# Reset-password limiter
RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
RESET_PASSWORD_RATE_LIMIT_MAX=5
